{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "..",
		"types": ["node"],
		"paths": {
			"atlasframework": ["../src/index.ts"],
			"atlasframework/jsx-runtime": ["../src/jsx-runtime.ts"],
			"atlasframework/jsx-dev-runtime": ["../src/jsx-dev-runtime.ts"],
			"atlasframework/providers/anthropic": ["../src/providers/anthropic.ts"]
