{
	"name": "atlasframework",
	"version": "0.0.1",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"import": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"import": "./dist/jsx-dev-runtime.js"
		}
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "npm run check && vite build && tsc",
		"dev": "vite build --watch",
		"demo": "tsx --tsconfig examples/tsconfig.json examples/tree.tsx"
	},
	"devDependencies": {
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
